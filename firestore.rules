rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: users/{userId}
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Allowed only if the user is authenticated and is the owner
      allow read: if isOwner(userId);

      // Allowed on registration/creation: user must be authenticated owner,
      // document uid must match userId, and walletBalance must be strictly initialized to 0 / 0.0
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && (request.resource.data.walletBalance == 0 || request.resource.data.walletBalance == 0.0)
                    && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 50))
                    && (!('mpesaPhone' in request.resource.data) || (request.resource.data.mpesaPhone is string && request.resource.data.mpesaPhone.size() <= 20));

      // Allowed on profile update: owner only; client MUST NOT be able to modify
      // walletBalance, uid, email, or createdAt. Only non-financial fields (displayName, mpesaPhone) may be changed.
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'mpesaPhone'])
                    && request.resource.data.walletBalance == resource.data.walletBalance
                    && request.resource.data.uid == resource.data.uid
                    && (!('email' in resource.data) || request.resource.data.email == resource.data.email)
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                    && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 50))
                    && (!('mpesaPhone' in request.resource.data) || (request.resource.data.mpesaPhone is string && request.resource.data.mpesaPhone.size() <= 20));

      // Deletions are forbidden from client SDKs
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: deposits/{depositId}
    // -------------------------------------------------------------------------
    match /deposits/{depositId} {
      // Read allowed only for the owning user
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Write (create/update/delete) denied for clients; strictly handled server-side via Firebase Admin SDK
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: withdrawals/{withdrawalId}
    // -------------------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      // Read allowed only for the owning user
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Write denied for clients; handled strictly server-side
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: game_bets/{betId}
    // -------------------------------------------------------------------------
    match /game_bets/{betId} {
      // Read allowed only for the owning user
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Write denied for clients; handled strictly server-side
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: unclaimed_deposits/{id}
    // -------------------------------------------------------------------------
    match /unclaimed_deposits/{id} {
      // Server-side audit/reconciliation only; all client reads and writes denied
      allow read, write: if false;
    }
  }
}
